# Brain Neural Network Configuration

# Environment
ENV=development
DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Model Configuration
MODEL_NAME=gpt2
MODEL_CACHE_DIR=.cache/models

# Network Parameters
NUM_NEURONS=100
LEARNING_RATE=0.01
BATCH_SIZE=32

# Memory Configuration
SHORT_TERM_MEMORY_SIZE=5
LONG_TERM_MEMORY_FILE=long_term_memory.json

# Attention Module
ATTENTION_THRESHOLD=0.5

# Emotion Module
EMOTION_TAU=100.0
EMOTION_UPDATE_RATE=0.01

# Decision Module
DECISION_THRESHOLD=1.0
DECISION_BIAS=0.0

# API Configuration (if applicable)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database (if applicable)
DATABASE_URL=sqlite:///brain.db

# Security
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here

# Hugging Face (if applicable)
HF_TOKEN=your-huggingface-token-here
HF_CACHE_DIR=.cache/huggingface
